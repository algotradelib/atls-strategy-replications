// Buy on gap (Chan 2013, Example 4.1): at the open, buy the `top` stocks that gapped down the most below the last low.
// A stock qualifies when it opens more than `entry` deviations of its daily returns below that low, and above its moving average.
// Each is bought for `capital / top` dollars and sold at the close.
// A missing value is left out of each window: the deviation is the sample deviation of the returns that exist.
// The first decision is on day window + 1, once there are `window` returns (the warm-up in `options`).
universe {}
options {
  missing = skip;
  // The first return is missing, so `stdev(ret, window)` alone is defined a day early, over window - 1 returns.
  warmup = window + 1;
}
params {
  int<lower=1> top = 10;
  int<lower=1> lookback = 20;
  int<lower=2> window = 90;
  real<lower=0> entry = 1;
  real<lower=0> capital = 1000000000;
}
series {
  real ret = close / close[1] - 1;
  real sd = stdev(ret, window);
  real mean = sma(close, lookback);
  real last_low = low;
}
state {
  bool bought = false;
}
on_open {
  bool down = defined(sd) and defined(mean) and defined(last_low) ? open < last_low * (1 - entry * sd) and open > mean : false;
  real rank = xs_rank(down ? open / last_low - 1 : keep);
  if (rank <= top) {
    target(floor(capital / top / open));
    bought = true;
  }
}
on_close {
  // Only what was bought: restating zero for every stock every day costs more than the strategy itself.
  if (bought) {
    target(0);
    bought = false;
  }
}
