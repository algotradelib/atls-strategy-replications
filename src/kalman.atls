// Kalman-filter mean reversion (Chan 2013, Example 3.3): the hedge of y on x drifts as a random walk.
// It enters when the forecast error leaves one deviation, on either side.
// The filter is C++ of the project's own, src/kalman.hpp, which kalman.toml names.
instruments {
  y;
  x;
}
params {
  real<lower=0, upper=1> delta = 0.0001;
  real<lower=0> ve = 0.001;
  int<lower=0> scale = 1000;
}
extern indicator kalman(real y, real x, real delta, real ve) {
  value real beta;
  value real error;
  value real sd;
}
series {
  real e = kalman(y.close, x.close, delta, ve).error;
  real sd = kalman(y.close, x.close, delta, ve).sd;
  real hedge = kalman(y.close, x.close, delta, ve).beta;
}
state {
  bool long = false;
  bool short = false;
}
on_bar {
  if (e < -sd) {
    long = true;
  } else if (e > -sd) {
    long = false;
  }
  if (e > sd) {
    short = true;
  } else if (e < sd) {
    short = false;
  }
  real units = (long ? 1 : 0) - (short ? 1 : 0);
  target(y, units * scale);
  target(x, round(-hedge * units * scale));
}
