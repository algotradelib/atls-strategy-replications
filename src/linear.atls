// Linear mean reversion on a price spread (Chan 2013, Example 3.1): hold minus the spread's z-score.
// A unit is `scale` shares of y, hedged with x.
instruments {
  y;
  x;
}
params {
  int<lower=2> lookback = 20;
  real<lower=0> scale = 100000;
}
series {
  real hedge = roll_ols(y.close, x.close, lookback).slope;
  real spread = y.close - hedge * x.close;
  real units = -roll_zscore(spread, lookback);
}
on_bar {
  target(y, round(units * scale));
  target(x, round(-hedge * units * scale));
}
